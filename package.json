{
  "name": "chequeexpress",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant cheque management with exact-size cheque printing",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "verify": "pnpm run typecheck:root && pnpm run lint && pnpm run format:check && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.5"
  }
}
