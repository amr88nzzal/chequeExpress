# Dependencies and caches (all of these must stay out of the repository)
node_modules/
.npm-cache/
.pnpm-store/
pnpm-store/
.yarn/
*.tsbuildinfo

# Build output
dist/
build/
coverage/
*.log

# Local scratch / analysis workspace (never committed)
_scratch/

# Workspace lockfiles: the single source of truth is the root package-lock.json.
# A per-workspace lockfile makes `npm ci` at the root diverge from what the
# workspace actually installed, so they are never committed.
apps/*/package-lock.json
packages/*/package-lock.json

# Throwaway probes written while diagnosing library behaviour.
probe*.mjs
packages/*/probe*.mjs
packages/*/tools/probe-*.ts

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
!*.pub

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Test and tooling artifacts
test-results/
playwright-report/
spikes/**/out/
spikes/**/t0.pdf
spikes/**/t1.pdf
spikes/**/t0.png
spikes/**/t1.png
