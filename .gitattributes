# Normalise text line endings to LF in the repository, regardless of the
# developer's `core.autocrlf`. git renders the committed blob with LF and checks
# it out with the working-tree setting below.

* text=auto eol=lf

# Excel/VBA: the .bas module is imported into the VBA editor, which expects CRLF.
*.bas text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files must never be line-ending converted.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.xlsm binary
*.xlsx binary
*.zip binary

# Generated files: keep them out of diffs and language stats.
package-lock.json -diff linguist-generated
