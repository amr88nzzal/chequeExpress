# Rendered by the nginx image (envsubst, only API_* variables). ${API_PORT} comes from infra/.env (PORT).
# TLS is terminated by the Cloudflare Tunnel (cloudflared) in front of this gateway,
# so the gateway speaks plain HTTP on the private network only.
server {
  listen 8080;
  server_name _;
  server_tokens off;
  client_max_body_size 10m;

  # Never expose liveness/readiness details beyond what the deploy script and tunnel need.
  location /health/ {
    proxy_pass http://api:${API_PORT};
    include /etc/nginx/proxy_params.conf;
  }

  location /api/ {
    proxy_pass http://api:${API_PORT}/;
    include /etc/nginx/proxy_params.conf;
  }

  # The web app (apps/web). Its own nginx handles SPA fallback and asset caching,
  # so the gateway only forwards. Note: the UI still talks to a mock API client
  # in-process; wiring it to /api/v1 is stage C1.
  location / {
    proxy_pass http://web:80;
    include /etc/nginx/proxy_params.conf;
  }
}
