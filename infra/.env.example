# infra/.env: the settings you may change. start.sh creates it from this file and replaces every
# "change-me" value with a random secret. Never commit infra/.env.

# Public port of the gateway on the host (and the API's listen port inside the container).
# Point the Cloudflare tunnel at http://localhost:<PORT>.
PORT=3650
# 127.0.0.1 = only this machine (and cloudflared). Use 0.0.0.0 to test directly from another machine.
BIND_ADDRESS=127.0.0.1

# Secret token for the API (required; the API refuses to start in production with a default or short value).
API_TOKEN=change-me

# Database: name, the owner account (creates the database, runs migrations) and the app account the API uses.
POSTGRES_DB=cheques
POSTGRES_OWNER_USER=cheques_owner
POSTGRES_OWNER_PASSWORD=change-me
APP_DB_USER=cheques_app
APP_DB_PASSWORD=change-me

IMAGE_TAG=local
